# Copie este arquivo para .env.local e preencha. O .env.local NÃO vai para o git.
# Depois de mudar o .env.local, reinicie o "npm run dev".

# Chave da OpenAI: chat que edita sozinho, ditado por voz, transcrição
# (legendas) e análise visual dos vídeos.
# Crie em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcionais (padrões entre parênteses):
# OPENAI_MODELO=gpt-6.1-sol          (editor do chat)
# OPENAI_MODELO_VISAO=gpt-6.1-sol    (descrição dos quadros dos vídeos)
# OPENAI_MODELO_DITADO=gpt-transcribe (ditado do chat)
# FFMPEG_PATH=                       (se o ffmpeg não estiver no PATH)
# MIDIA_DIR=./midia
# MIDIA_LIMITE_MB=1024

# Criptografa as chaves de acesso dos clientes (Meta) guardadas no banco.
# Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave = cada cliente cola a chave dele de novo.
ENCEDITOR_CHAVE_SEGREDOS=

# Versão da API da Meta (métricas do Instagram e dos anúncios). Quando a
# Meta lançar uma nova, troque aqui. Padrão: v26.0.
# META_GRAPH_VERSAO=v26.0

# Alternativa: editor com Claude (usado só se NÃO houver OPENAI_API_KEY).
# ANTHROPIC_API_KEY=
